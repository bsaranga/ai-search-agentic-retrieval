{
  "name": "coffee-posts-sql",
  "fields": [
    { "name": "id", "type": "Edm.String", "key": true, "filterable": true },
    { "name": "kind", "type": "Edm.String", "filterable": true, "facetable": true, "retrievable": true },
    { "name": "questionId", "type": "Edm.String", "filterable": true, "sortable": true, "retrievable": true },

    { "name": "title", "type": "Edm.String", "searchable": true, "analyzer": "en.microsoft", "retrievable": true },
    { "name": "body",  "type": "Edm.String" },
    { "name": "chunk", "type": "Edm.String", "searchable": true, "analyzer": "en.microsoft", "retrievable": false },
    { "name": "chunkVector", "type": "Collection(Edm.Single)", "searchable": true, "retrievable": false, "dimensions": 1536, "vectorSearchProfile": "default-profile" },

    { "name": "tags", "type": "Collection(Edm.String)", "searchable": true, "filterable": true, "facetable": true, "retrievable": true },

    { "name": "score",        "type": "Edm.Int32", "filterable": true, "sortable": true, "retrievable": true },
    { "name": "parentScore",  "type": "Edm.Int32", "filterable": true, "sortable": true, "retrievable": true },
    { "name": "viewCount",    "type": "Edm.Int32", "filterable": true, "sortable": true, "retrievable": true },
    { "name": "answerCount",  "type": "Edm.Int32", "filterable": true, "sortable": true, "retrievable": true },
    { "name": "commentCount", "type": "Edm.Int32", "filterable": true, "sortable": true, "retrievable": true },

    { "name": "isAccepted",       "type": "Edm.Boolean", "filterable": true, "retrievable": true },
    { "name": "acceptedAnswerId", "type": "Edm.String",  "filterable": true, "retrievable": true },

    { "name": "creationDate",     "type": "Edm.DateTimeOffset", "filterable": true, "sortable": true, "retrievable": true },
    { "name": "lastActivityDate", "type": "Edm.DateTimeOffset", "filterable": true, "sortable": true, "retrievable": true },

    { "name": "ownerUserId",      "type": "Edm.String", "filterable": true, "retrievable": true },
    { "name": "ownerDisplayName", "type": "Edm.String", "searchable": true, "filterable": true, "retrievable": true },

    { "name": "url", "type": "Edm.String", "retrievable": true }
  ],
  "suggesters": [
    { "name": "sg", "searchMode": "analyzingInfixMatching", "sourceFields": ["title", "tags"] }
  ],
  "scoringProfiles": [
    {
      "name": "qa-relevance",
      "text": { "weights": { "title": 5, "body": 1 } },
      "functions": [
        { "type": "magnitude", "fieldName": "score",       "boost": 3, "interpolation": "logarithmic",
          "magnitude": { "boostingRangeStart": 0, "boostingRangeEnd": 100, "constantBoostBeyondRange": true } },
        { "type": "magnitude", "fieldName": "parentScore", "boost": 2, "interpolation": "logarithmic",
          "magnitude": { "boostingRangeStart": 0, "boostingRangeEnd": 100, "constantBoostBeyondRange": true } },
        { "type": "freshness", "fieldName": "creationDate","boost": 1.2, "interpolation": "quadratic",
          "freshness": { "boostingDuration": "P1095D" } }
      ],
      "functionAggregation": "sum"
    }
  ],
  "semantic": {
    "configurations": [
      {
        "name": "default-semantic",
        "prioritizedFields": {
          "titleField": { "fieldName": "title" },
          "prioritizedContentFields": [{ "fieldName": "chunk" }],
          "prioritizedKeywordsFields": [{ "fieldName": "tags" }]
        }
      }
    ]
  },
  "vectorSearch": {
    "algorithms": [
      { "name": "hnsw-default", "kind": "hnsw",
        "hnswParameters": { "m": 4, "efConstruction": 400, "efSearch": 500, "metric": "cosine" } }
    ],
    "profiles": [
      { "name": "default-profile", "algorithm": "hnsw-default", "vectorizer": "aoai-vectorizer" }
    ],
    "vectorizers": [
      {
        "name": "aoai-vectorizer",
        "kind": "azureOpenAI",
        "azureOpenAIParameters": {
          "resourceUri": "https://seminar.openai.azure.com",
          "deploymentId": "text-embedding-3-small",
          "modelName": "text-embedding-3-small"
        }
      }
    ]
  },
  "corsOptions": { "allowedOrigins": ["*"], "maxAgeInSeconds": 300 }
}
